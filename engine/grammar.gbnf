root ::= "{" ws "\"intent\"" ws ":" ws intent ws "," ws "\"time_range\"" ws ":" ws "{" ws "\"start\"" ws ":" ws string ws "," ws "\"end\"" ws ":" ws string ws "}" ws "," ws "\"signals\"" ws ":" ws array ws "," ws "\"filters\"" ws ":" ws object ws "}"
intent ::= "\"range_analysis\"" | "\"efficiency_drop_changepoint\"" | "\"adas_disengagements\"" | "\"pre_event_timeline\"" | "\"city_vs_highway_compare\"" | "\"sensor_anomaly\"" | "\"unknown\""
array ::= "[" ws (string (ws "," ws string)*)? ws "]"
object ::= "{" ws (string ws ":" ws scalar (ws "," ws string ws ":" ws scalar)*)? ws "}"
scalar ::= string | number | "true" | "false" | "null"
string ::= "\"" chars "\""
chars ::= ([^"\\] | "\\" ["\\/bfnrt] | "\\u" hex hex hex hex)*
number ::= "-"? [0-9]+ ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
hex ::= [0-9a-fA-F]
ws ::= ([ \t\n\r]*)